area-id: JP13
file-format: aac
downloads: /radiko # Docker-specific path (aligned with docker-compose.yml). For non-container usage, use $HOME/Downloads/radiko or a relative path like ./radiko
# max-downloading-concurrency: 64  # Maximum concurrent download operations (default: 64)
# max-encoding-concurrency: 2  # Maximum concurrent encoding operations for MP3 conversion (default: 2)
# The first matching rule wins: when a program matches several rules, the one
# declared earliest decides the folder. Order the rules from most specific to
# most general.
rules:
    airship:
        folder: citypop
        station-id: FMT
        title: "GOODYEAR MUSIC AIRSHIP～シティポップ レイディオ～"
    citypop:
        keyword: "シティポップ"
        # (optional) reject programs this rule would otherwise match.
        # Any single criterion below is enough to skip the program.
        exclude:
            keyword: "再放送"
